# DCLM Bahrain CMS, production environment
#
# Copy this to .env on the server, fill in every value marked CHANGE ME,
# then run: chmod 600 .env
#
# Never commit the filled-in version. It holds the keys to the church's
# records.

# ---- Which settings file to load ----
DJANGO_SETTINGS_MODULE=config.settings.production

# ---- Secrets ----
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this signs everyone out, which is the point if it ever leaks.
DJANGO_SECRET_KEY=CHANGE ME

# ---- Where the site lives ----
# The domain people type. No https://, no trailing slash.
DJANGO_ALLOWED_HOSTS=cms.dclm-bh.org
# Full URLs, with https://. Used for CSRF and for links inside emails.
DJANGO_CSRF_TRUSTED_ORIGINS=https://cms.dclm-bh.org
CORS_ALLOWED_ORIGINS=https://cms.dclm-bh.org
APP_BASE_URL=https://cms.dclm-bh.org

# ---- Database ----
# Generate the password with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_URL=postgres://dclmuser:CHANGE ME@localhost:5432/dclm

# ---- Email notifications (optional) ----
# Leave NOTIFICATIONS_ENABLED=False and the system works fine without
# email. Nothing is sent while it is False, which protects a staging
# copy of the real database from emailing the congregation.
#
# Resend gives 3,000 emails a month free and is enough for a church this
# size. Brevo is a good alternative. Mailtrap's free tier is a testing
# inbox that never delivers to real people, so it is not suitable here.
NOTIFICATIONS_ENABLED=False
DEFAULT_FROM_EMAIL=DCLM Bahrain <noreply@dclm-bh.org>
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=CHANGE ME

# ---- File storage ----
# Leave these blank on a normal server: uploads go to the local disk,
# which is correct when the disk is persistent.
#
# Only set them on Azure App Service, where the local disk is not
# reliably persistent and receipts would be lost.
AZURE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
