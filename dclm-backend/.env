# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.local

# Database. Local dev defaults to SQLite if this is left unset.
# Azure Database for PostgreSQL connection string format:
# postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/<dbname>?sslmode=require
DATABASE_URL=

# Production only
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# Azure Blob Storage (Batch 2.8) — production only, required there.
# Connection string format (from the Azure portal, under the Storage
# Account's "Access keys" page):
# DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=dclm-files
