# Scheduled jobs on an ordinary Linux server.
#
# NOT for Azure App Service, which has no cron. If you are on App Service
# see deploy/webjobs/ or deploy/azure-function/ instead.
#
# Until check_absences runs, no follow-up task is ever created and the
# feature looks broken while working perfectly.

0 * * * *   cd /home/dclm/dclm-backend && ./venv/bin/python manage.py check_absences >> /var/log/dclm-cron.log 2>&1
0 2 * * *   cd /home/dclm/dclm-backend && ./venv/bin/python manage.py generate_recurring_sessions >> /var/log/dclm-cron.log 2>&1
0 7 * * *   cd /home/dclm/dclm-backend && ./venv/bin/python manage.py send_followup_digests >> /var/log/dclm-cron.log 2>&1
30 7 * * 1  cd /home/dclm/dclm-backend && ./venv/bin/python manage.py send_leadership_summary >> /var/log/dclm-cron.log 2>&1

# A backup as well. Nothing is backing the database up until this runs.
0 1 * * *   pg_dump dclm | gzip > /home/dclm/backups/dclm-$(date +\%F).sql.gz
